# Скопировать в .env и заполнить. .env в .gitignore, в репозиторий не попадает.

# Anthropic — нужен для всех агентов
ANTHROPIC_API_KEY=

# SuperJob: регистрация приложения https://api.superjob.ru/register/
# SUPERJOB_SECRET — это «секретный ключ» приложения, уходит в заголовок X-Api-App-Id
SUPERJOB_CLIENT_ID=
SUPERJOB_SECRET=
# Логин и пароль моего аккаунта соискателя — для POST /2.0/oauth2/password/
SUPERJOB_LOGIN=
SUPERJOB_PASSWORD=

# hh.ru: приложение регистрируется на https://dev.hh.ru/admin и проходит модерацию.
# Пока приложения нет — оставить пустыми, hh.ru работает в режиме RSS (см. docs/api_notes.md)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=

# Идентификаторы моих резюме на площадках — без них отклик отправлять нечем.
# SuperJob: GET /2.0/user_cvs/ отдаёт список, нужен id нужного резюме.
# hh.ru: GET /resumes/mine
SUPERJOB_CV_ID=
HH_RESUME_ID=

# Telegram: чтение публичных каналов с вакансиями под своим аккаунтом.
# api_id и api_hash получаются на https://my.telegram.org → API development tools.
# Вход выполняется один раз: `jobagent telegram login` (спросит телефон и код).
# Файл сессии — это доступ к аккаунту, он в .gitignore и никуда не уходит.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=output/telegram.session

# Контактный адрес в User-Agent — площадки этого требуют
CONTACT_EMAIL=
